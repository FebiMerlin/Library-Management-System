# Build environment for the CI runner (and for reproducing CI locally):
#   docker build -f infra/Dockerfile.build -t lms-builder infra
#   docker run --rm -v "$PWD:/src" -w /src lms-builder sh -c "cmake --preset ci && cmake --build --preset ci"
FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential clang cmake ninja-build git ca-certificates \
        python3 python3-pip nodejs \
    && pip3 install --break-system-packages clang-format==23.1.1 \
    && rm -rf /var/lib/apt/lists/*

# Same defaults as GitHub-hosted ubuntu-latest, so ci.yml behaves identically.
ENV CC=gcc CXX=g++
WORKDIR /src
